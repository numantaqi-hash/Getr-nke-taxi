# ==========================================================================
# GetränkeTaxi Greifswald – Umgebungsvariablen (PLATZHALTER – keine echten Keys!)
# Kopiere diese Datei nach ".env.local" und trage deine Supabase-Werte ein.
# .env.local wird von git ignoriert.
# ==========================================================================

# --- Supabase (Projekt-Einstellungen → API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig verwenden (Admin-Client, spätere Admin-Funktionen).
# NIEMALS mit NEXT_PUBLIC_ präfixen oder ins Frontend geben!
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Geheimer Code für die Fahrer-Registrierung (frei wählbar).
# Nur mit diesem Code kann sich jemand als Fahrer registrieren.
# Leer lassen = Fahrer-Selbstregistrierung komplett deaktiviert.
DRIVER_SIGNUP_CODE=

# ==========================================================================
# Zukünftige Features – Platzhalter, aktuell ungenutzt
# ==========================================================================

# --- Live GPS Tracking (z. B. Karten-Anbieter) ------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Payment Integration (z. B. Stripe) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Notifications (z. B. Web Push / VAPID) ---------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
