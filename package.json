  "description": "GetränkeTaxi Greifswald – Next.js 14 App mit Supabase-Backend (Konzept-Prototyp).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
